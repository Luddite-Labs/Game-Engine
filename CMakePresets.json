{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 5,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-ninja",
            "hidden": false,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_VS_VERSION_PRERELEASE": "ON",
                "CMAKE_VS_VERSION_RANGE": "[16.0,19.0)",
                "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION_MAXIMUM": "10.0.26100.0",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "windows-vs2022",
            "hidden": true,
            "generator": "Visual Studio 18 2022",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "windows-vs2022-x64",
            "inherits": "windows-vs2022",
            "hidden": false,
            "cacheVariables": {
                "CMAKE_GENERATOR_PLATFORM": "x64,version=10.0.26100.0",
                "CMAKE_SYSTEM_PROCESSOR": "AMD64",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "GCC 13.3.0 x86_64-linux-gnu",
            "description": "Using compilers: C = /usr/bin/gcc, CXX = /usr/bin/g++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-vs2022",
            "configurePreset": "windows-vs2022"
        },
        {
            "name": "windows-vs2022-x64",
            "configurePreset": "windows-vs2022-x64"
        }
    ]
}